// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// AQUÍ ESTÁ LA CORRECCIÓN: Quitamos la línea "url = ..."
datasource db {
  provider = "postgresql"
}

// Tabla para los Meseros o Administradores
model User {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   @default("MESERO") // Puede ser MESERO o ADMIN
  pin       String   @unique // Un PIN corto para que el mesero entre rápido a la app
  orders    Order[]
  draftSnapshots UserDraftSnapshot[]
  sessionLogs SessionLog[]
}

// Tabla para los Platos y Bebidas (El Menú)
model Product {
  id          Int         @id @default(autoincrement())
  name        String
  category    String      // Ej: "Bebidas", "Carnes", "Entradas"
  price       Float
  orderItems  OrderItem[]
}

// Tabla para las Mesas del restaurante
model Table {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  capacity  Int      @default(4)      // Capacidad de personas
  status    String   @default("libre") // libre, ocupada, atencion
  x         Int      @default(0)       // Ubicación horizontal (0-100%)
  y         Int      @default(0)       // Ubicación vertical (0-100%)
  orders    Order[]
}

// Tabla principal del Pedido
model Order {
  id        Int         @id @default(autoincrement())
  status    String      @default("PENDIENTE") // PENDIENTE, PREPARANDO, LISTO
  createdAt DateTime    @default(now())
  
  // Quién tomó el pedido y en qué mesa
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  tableId   Int
  table     Table       @relation(fields: [tableId], references: [id])
  
  items     OrderItem[]
  payments  Payment[]
}

// Tabla para los detalles de cada plato dentro de un pedido
model OrderItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  paidQuantity Int   @default(0)
  notes     String?  // Ej: "Sin cebolla", "Término medio"

  // ---> NUEVO CAMPO IHC: ESTADO EN COCINA <---
  cookStatus String   @default("PENDIENTE") // Estados: PENDIENTE, PREPARANDO, LISTO
  
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       Int
  subtotal      Float
  serviceAmount Float   @default(0)
  total         Float
  items         Json
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model UserDraftSnapshot {
  id        Int      @id @default(autoincrement())
  userId    Int
  items     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SessionLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  loginAt   DateTime @default(now())
  logoutAt  DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
  @@index([loginAt, logoutAt])
}

// --- NUEVA TABLA: LISTA DE ESPERA (IHC) ---
model Waitlist {
  id        Int      @id @default(autoincrement())
  name      String
  partySize Int      // Tamaño del grupo (Ej: 4 personas)
  phone     String?  // Opcional
  status    String   @default("WAITING") // Estados: WAITING, SEATED, CANCELLED
  createdAt DateTime @default(now())
}

